---
import {
  getCollection,
  type CollectionEntry,
  type CollectionKey,
} from "astro:content";

type PageData = {
  title: string;
  meta_title?: string;
  description?: string;
  image?: string;
  draft?: boolean;
};

export const getSinglePage = async <C extends CollectionKey>(
  collectionName: C
): Promise<CollectionEntry<C>[]> => {
  return getCollection(collectionName, ({ id, data }) => {
    if (id.startsWith("-")) return false;
    const pageData = data as PageData;
    return pageData.draft !== true;
  });
};
---
