---
import Logo from "@/components/Logo.astro";
import menu from "@/config/menu.json";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPath = (url: string) => {
  const menuPath = url.replace(/\/$/, "") || "/";
  return currentPath === menuPath;
};
---

<header class="header pt-6">
  <!-- logo -->
  <div class="order-0 mx-auto text-center">
    <Logo />
    <a
      href="/"
      class="title text-2xl sm:text-5xl md:text-7xl font-playfair text-center no-underline transition-colors duration-300 leading-tight md:leading-title-line-height tracking-custom font-black uppercase hover:text-hoverColor mb-4 sm:mb-6 md:mb-9 text-titleColor"
    >
      BLUE POINT ART
    </a>
    <p
      class="subtitle font-secondary text-center text-lg sm:text-xl md:text-xl font-normal tracking-wide sm:tracking-wider md:tracking-widest uppercase mt-2 sm:mt-6 md:mt-4 mb-3 sm:mb-4 md:mb-5"
    >
      DIGITAL ENVIRONMENT FOR DOCUMENTARY, EDUCATIONAL AND CREATIVE ACTIVITIES
    </p>
  </div>

  <div class="order-1 border border-gray-300 font-secondary">
    <nav
      class="navbar container flex justify-between items-center flex-wrap border-l border-gray-300 border-r border-gray-300"
      aria-label="Primary"
    >
      <!-- navbar toggler -->
      <input id="nav-toggle" type="checkbox" class="peer hidden" />
      <label
        id="menu-button"
        for="nav-toggle"
        class="order-1 flex cursor-pointer items-center text-black"
        aria-controls="nav-menu"
        aria-label="Toggle menu"
      >
        <svg class="menu-open-icon h-6 w-6 fill-current" viewBox="0 0 20 20" aria-hidden="true">
          <title>Menu Open</title>
          <path d="M1 3h18v2H1V3zm0 6h18v2H1V9zm0 6h18v2H1v-2z"></path>
        </svg>
        <svg class="menu-close-icon hidden h-6 w-6 fill-current" viewBox="0 0 20 20" aria-hidden="true">
          <title>Menu Close</title>
          <polygon
            points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
            transform="rotate(45 10 10)"></polygon>
        </svg>
      </label>
      <!-- /navbar toggler -->

      <ul
        id="nav-menu"
        class="navbar-nav order-3 hidden w-full peer-checked:block active:scale-97 transition-transform duration-150"
      >
        {
          main.map((menu) => {
            const menuId = menu.name.toLowerCase().replace(/\s+/g, "-");
            const hasActiveChild =
              menu.children?.some((child) => isCurrentPath(child.url)) ?? false;
            const isActive = isCurrentPath(menu.url) || hasActiveChild;
            return (
              <>
                {menu.hasChildren ? (
                  <li class="nav-item nav-dropdown relative group">
                    <input
                      type="radio"
                      name="primary-submenu"
                      id={`toggle-${menuId}`}
                      class="peer hidden"
                    />

                    <label
                      for={`toggle-${menuId}`}
                      class={`nav-link cursor-pointer ${isActive ? "is-active" : ""}`}
                      aria-haspopup="true"
                      aria-controls={`submenu-${menuId}`}
                    >
                      {menu.name}
                      <svg class="h-5 w-5 ml-1" viewBox="0 0 20 20">
                        <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                      </svg>
                    </label>

                    <ul
                      id={`submenu-${menuId}`}
                      class="nav-dropdown-list hidden peer-checked:block md:group-hover:block"
                    >
                      {menu.children?.map((child) => (
                        <li class="nav-dropdown-item">
                          <a
                            href={child.url}
                            class={`nav-dropdown-link ${isCurrentPath(child.url) ? "is-active" : ""}`}
                            aria-current={isCurrentPath(child.url) ? "page" : undefined}
                          >
                            {child.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="nav-item">
                    <a
                      href={menu.url}
                      class={`nav-link ${isActive ? "is-active" : ""}`}
                      aria-current={isActive ? "page" : undefined}
                    >
                      {menu.name}
                    </a>
                  </li>
                )}
              </>
            );
          })
        }
      </ul>

      <div class="order-2 ml-auto flex">
        <a
          class="mr-4 inline-block cursor-pointer p-2 text-xl text-dark transition hover:text-primary md:mr-0"
          href="/search"
          title="search"
          aria-label="search"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <span class="sr-only">Search</span>
        </a>
      </div>
    </nav>
  </div>
</header>
